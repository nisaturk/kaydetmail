<?xml version="1.0" encoding="utf-8"?>
<!-- Card background for the home-screen mail widget: white surface, light
     border, rounded corners — matches AppTheme's monochrome light palette
     (lib/theme/app_theme.dart AppColors.light.border/surface). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FFFFFF" />
    <stroke android:width="1dp" android:color="#E5E7EB" />
    <corners android:radius="16dp" />
</shape>
